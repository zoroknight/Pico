{
  "format_version": 1,
  "id": "inspect-project-assets",
  "version": "1.1.0",
  "description": "Inspect versioned Pico AssetDescriptor records and the active World without modifying the project.",
  "triggers": ["资产目录", "资产描述器", "查找资产", "搜索资产", "找出项目中的", "项目中的模型", "项目中的材质", "AssetDescriptor", "asset catalog", "asset search", "find assets", "list meshes", "list materials", "describe catalog", "provenance", "validator_id"],
  "recommended_tools": [
    "editor.asset.describe_catalog",
    "editor.asset.search",
    "editor.world.describe",
    "editor.object.describe"
  ],
  "preconditions": ["A Pico project is open."],
  "workflow": [
    "Call editor.asset.describe_catalog once to obtain the versioned project asset and active World descriptors, including per-type technical characteristics.",
    "Use editor.asset.search to narrow the catalog by path, type, or user-confirmed semantic metadata such as display name, description, and tags.",
    "If a known World Actor may reference an unresolved asset, call editor.world.describe and then editor.object.describe to read its component asset properties; read-only inspection does not require additional user approval.",
    "Report only paths, kinds, dependencies, provenance, validator ids, summaries, and evidence returned by tools; never infer binary asset contents."
  ],
  "completion_criteria": [
    "The response cites AssetDescriptor or semantic-search facts returned by tools and distinguishes deterministic technical characteristics from unknown visual semantics.",
    "No project or World mutation tool was available or invoked."
  ]
}
